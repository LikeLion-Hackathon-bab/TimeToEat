# TimeToEat(Spring) 로컬 실행용 견본. 복사해서 .env로 쓴다(.env는 git에 올리지 않는다).
# 설명과 운영 값은 docs/ENV.md. 아래 값은 모두 가짜 예시다. 실제 비밀값을 이 파일에 쓰지 않는다.
# 로컬: set -a; . ./.env; set +a; ./gradlew bootRun   (CORS_ALLOWED_ORIGINS 등은 OS 환경변수로만 읽힌다)

# ── DB (MySQL 8) ── mysql 컨테이너도 같은 파일을 읽는다
DB_URL=jdbc:mysql://localhost:3306/timetoeat
DB_USERNAME=timetoeat
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=timetoeat
MYSQL_USER=timetoeat
MYSQL_PASSWORD=change-me
# 빈 DB를 처음 만들 때만 create로 한 번 띄우고 다시 validate로 바꾼다
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── Redis / RabbitMQ ──
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=timetoeat
RABBITMQ_DEFAULT_PASS=change-me

# ── 인증 ── JWT_SECRET은 32바이트 이상(openssl rand -base64 48). Socket과 같은 값
JWT_SECRET=replace-with-at-least-32-bytes-random-string
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
# 카카오 콘솔에 등록한 Redirect URI와 글자까지 같아야 한다
CLIENT_REDIRECT_PATH=http://localhost:8080/login/oauth2/code/kakao
KAKAO_SCOPE=profile_nickname,profile_image

# ── Client 주소·쿠키·CORS ──
CLIENT_LOGIN_REDIRECT=http://localhost:3001/
CORS_ALLOWED_ORIGINS=http://localhost:3001
# 비우면 호스트 전용 쿠키(권장). .vercel.app 같은 공개 접미사는 넣지 않는다
AUTH_COOKIE_DOMAIN=
APP_REFERRAL_BASE_URL=http://localhost:3001/invite

# ── Socket 연동 ── ROOM_RESULT_KEY는 Socket과 같은 값(openssl rand -hex 32). Client에는 넣지 않는다
SOCKET_BASE_URL=http://localhost:3000
ROOM_RESULT_KEY=replace-with-shared-room-key

# ── AI (선택) ── AI_OUTBOUND_KEY가 비면 AI 호출을 끈다. APP_AI_API_KEY가 비면 AI→Spring 호출을 403으로 거부한다
FOOD_AI_BASE_URL=http://localhost:8000
RECO_AI_BASE_URL=http://localhost:8010
TASTE_BASE_URL=http://localhost:8020
AI_OUTBOUND_KEY=
APP_AI_API_KEY=
AI_HTTP_TIMEOUT_MILLIS=3000
